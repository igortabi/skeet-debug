<Project>
  <!--
    Imported automatically by every project in this repo, after the project's own settings.

    Reproducible Release builds: the same commit built with the same toolset gives byte-identical
    binaries, so anyone can rebuild a release and compare its SHA-256 with the published one.
      /Brepro       no timestamps; PE timestamp and PDB id become content hashes
      /pathmap      no absolute source paths in the objects
      /PDBALTPATH   only the PDB file name in the binary, not the builder's directory
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <AdditionalOptions>%(AdditionalOptions) /Brepro "/pathmap:$(MSBuildThisFileDirectory.TrimEnd('\'))=."</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>%(AdditionalOptions) /Brepro /PDBALTPATH:%25_PDB%25</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!--
    Build identity for skeet.dll: writes $(IntDir)build_info.h with the git commit, whether tracked
    files had uncommitted changes, and the release tag on that commit. lua_loadstring_guard.cpp
    exposes it to Lua as skeetsdk.build. Contains no paths or times, so it stays reproducible.
    Builds without git (e.g. from a zip) report commit "unknown".
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='skeet'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <Target Name="SkeetDebugBuildInfo" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)'=='skeet'">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SkeetDebugCommit" />
      <Output TaskParameter="ExitCode" PropertyName="SkeetDebugCommitExit" />
    </Exec>
    <Exec Command="git diff --quiet HEAD --" WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          Condition="'$(SkeetDebugCommitExit)'=='0'">
      <Output TaskParameter="ExitCode" PropertyName="SkeetDebugDiffExit" />
    </Exec>
    <Exec Command="git describe --tags --exact-match HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          Condition="'$(SkeetDebugCommitExit)'=='0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="SkeetDebugTagOutput" />
      <Output TaskParameter="ExitCode" PropertyName="SkeetDebugTagExit" />
    </Exec>

    <PropertyGroup>
      <SkeetDebugCommit Condition="'$(SkeetDebugCommitExit)'!='0'">unknown</SkeetDebugCommit>
      <SkeetDebugDirty>0</SkeetDebugDirty>
      <SkeetDebugDirty Condition="'$(SkeetDebugDiffExit)'=='1'">1</SkeetDebugDirty>
      <SkeetDebugTag></SkeetDebugTag>
      <SkeetDebugTag Condition="'$(SkeetDebugTagExit)'=='0'">$(SkeetDebugTagOutput)</SkeetDebugTag>
    </PropertyGroup>

    <ItemGroup>
      <SkeetDebugBuildInfoLine Include="// Generated by Directory.Build.targets. Do not edit." />
      <SkeetDebugBuildInfoLine Include="#pragma once" />
      <SkeetDebugBuildInfoLine Include="#define SKEET_DEBUG_COMMIT &quot;$(SkeetDebugCommit)&quot;" />
      <SkeetDebugBuildInfoLine Include="#define SKEET_DEBUG_DIRTY $(SkeetDebugDirty)" />
      <SkeetDebugBuildInfoLine Include="#define SKEET_DEBUG_TAG &quot;$(SkeetDebugTag)&quot;" />
    </ItemGroup>
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)build_info.h" Lines="@(SkeetDebugBuildInfoLine)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
