# Same bytes in every checkout, so release builds are reproducible whatever core.autocrlf is.
* text=auto eol=crlf

# Embedded into skeet.dll by skeet.rc: never convert, the DLL contains these bytes as-is.
*.bin binary
skeet/Binary/*.json -text
skeet/VM/*.json -text

# Font Awesome fonts are embedded into skeet.dll as-is: never convert them.
*.otf binary
*.ttf binary
